<!--
    Layout for 16:9 and 16:10 displays (for example 1920x1080, 2560x1440, 3840x2160).

    Grid: outer margin 0.06, header at 0.085, content from 0.175 to 0.885, footer at 0.93.
    Index: list 0.06-0.36, then title, framed media and facts in the 0.41-0.94 column.
    Grid variant: covers 0.06-0.495, then title, description and the media card
    (0.51-0.82) with the facts beside it in the 0.545-0.94 column.
-->

<theme>
    <!-- The clock ends the header line, with Wi-Fi and then the battery to its left, one
         entry spacing (0.008) apart. Wi-Fi is placed by the widest time, 00:00, which is
         3.37 em of the status size; other times leave a little more room. The icons are
         as wide as they are tall, a share of the screen height, so these values are
         halfway between 16:9 and 16:10.
         The Index title is centered on its capitals, which start where those of the first
         row of the list do: 0.175 + 0.4155 em of the list size, plus 0.3785 em of the
         title size to the middle of the capitals (see layout/gamelist-index.xml), then
         0.0009 higher (0.0018 at x-large), as measured in ES-DE at 1920x1080. Checked
         there, at 1440x1080 and at 2560x1080: the same row of pixels at every size -->
    <variables>
        <wifiPos>0.884 0.085</wifiPos>
        <statusPos>0.862 0.085</statusPos>
        <indexTitlePos>0.41 0.2073</indexTitlePos>
    </variables>
    <fontSize name="small">
        <variables>
            <wifiPos>0.89 0.085</wifiPos>
            <statusPos>0.87 0.085</statusPos>
            <indexTitlePos>0.41 0.2035</indexTitlePos>
        </variables>
    </fontSize>
    <fontSize name="large">
        <variables>
            <wifiPos>0.876 0.085</wifiPos>
            <statusPos>0.851 0.085</statusPos>
            <indexTitlePos>0.41 0.2124</indexTitlePos>
        </variables>
    </fontSize>
    <fontSize name="x-large">
        <variables>
            <wifiPos>0.866 0.085</wifiPos>
            <statusPos>0.838 0.085</statusPos>
            <indexTitlePos>0.41 0.2127</indexTitlePos>
        </variables>
    </fontSize>

    <variant name="all">
        <view name="system, gamelist">
            <helpsystem name="help">
                <pos>0.06 0.93</pos>
            </helpsystem>
            <systemstatus name="systemStatus">
                <pos>${statusPos}</pos>
            </systemstatus>
            <systemstatus name="systemStatusWifi">
                <pos>${wifiPos}</pos>
            </systemstatus>
            <clock name="clock">
                <pos>0.94 0.085</pos>
            </clock>
        </view>

        <!-- Custom collection header, see collections.xml -->
        <view name="gamelist">
            <text name="collectionTitle">
                <pos>0.125 0.085</pos>
                <origin>0 0.5</origin>
                <size>0.6 0.06</size>
            </text>
            <text name="collectionPlatform">
                <pos>0.125 0.128</pos>
                <origin>0 0.5</origin>
                <size>0.6 0.03</size>
            </text>
            <text name="collectionName">
                <pos>0.94 0.86</pos>
                <origin>1 1</origin>
                <size>0.6 0.5</size>
                <fontSize>0.15</fontSize>
            </text>
        </view>
    </variant>

    <!-- The system carousel, see layout/system-carousel.xml -->
    <variant name="index, indexStill, indexCompact, indexCompactStill, typographic, gallery, grid, indexNames, indexStillNames, indexCompactNames, indexCompactStillNames, typographicNames, galleryNames, gridNames">
        <view name="system">
            <carousel name="systemCarousel">
                <itemSize>0.2 0.24</itemSize>
                <itemScale>1.75</itemScale>
                <maxItemCount>3.6</maxItemCount>
                <selectedItemMargins>0.045 0.045</selectedItemMargins>
                <verticalOffset>-0.17</verticalOffset>
            </carousel>
            <image name="roomLight">
                <pos>0.5 0.33</pos>
                <size>0.8 0.95</size>
            </image>
            <text name="systemTitle, autoCollectionTitle, customCollectionTitle">
                <pos>0.5 0.65</pos>
                <origin>0.5 1</origin>
                <size>0.88 0.2</size>
                <fontSize>${sysTitleSizeNarrow}</fontSize>
            </text>
            <text name="caption">
                <pos>0.5 0.69</pos>
                <origin>0.5 0.5</origin>
                <size>0.88 0.04</size>
            </text>
            <text name="description">
