                <origin>0.5 0</origin>
                <size>0.58 0.095</size>
            </text>
            <text name="gameCount">
                <pos>0.5 0.856</pos>
                <origin>0.5 0.5</origin>
                <size>0.5 0.04</size>
            </text>
        </view>
    </variant>

    <!-- The Names variants, see layout/system-names.xml. The carousel items gain the strips
         above and below the drawing; the veil covers the name of the selected system,
         from just beneath the tallest drawing, and stops short of its neighbors -->
    <variant name="indexNames, indexStillNames, indexCompactNames, indexCompactStillNames, typographicNames, galleryNames, gridNames">
        <view name="system">
            <carousel name="systemCarousel">
                <itemSize>0.2 0.4128</itemSize>
            </carousel>
            <image name="selectedNameVeil">
                <pos>0.5 0.62</pos>
                <size>0.4 0.15</size>
            </image>
        </view>
    </variant>

    <!-- The List variants, see layout/system-list.xml. The list of systems is where the
         Index has its list of games, the selected system is described in the 0.41-0.94
         column: the drawing on the top edge of the list, standing on 0.41, the name
         beneath it with room for a second line, then the rule and caption, the history
         down to the bottom of the list and the number of games on the line of the
         Index's game count. The year is centered on the drawing, against the right edge -->
    <variant name="indexList, indexStillList, indexCompactList, indexCompactStillList, typographicList, galleryList, gridList">
        <view name="system">
            <textlist name="systemList">
                <pos>0.06 0.175</pos>
                <origin>0 0</origin>
                <size>0.3 0.65</size>
                <horizontalMargin>0.011</horizontalMargin>
                <selectorWidth>0.0012</selectorWidth>
                <selectorHeight>${selectorH}</selectorHeight>
                <selectorVerticalOffset>${selectorY}</selectorVerticalOffset>
            </textlist>
            <!-- The fade ends 0.001 past the text edge (0.349): ES-DE rounds the list's clip
                 in three steps, which can put its edge up to 1.4 px further right -->
            <image name="listFade">
                <pos>0.35 0.175</pos>
                <origin>1 0</origin>
                <size>0.035 0.65</size>
            </image>
            <image name="systemArt">
                <pos>0.41 0.41</pos>
                <origin>0 1</origin>
                <maxSize>0.34 0.235</maxSize>
            </image>
            <!-- Centered on the drawing, whose width depends on the system: set for each
                 one by systems/eyebrow (see tools/build-eyebrows.js), also for 16:10 -->
            <image name="roomLight">
                <pos>${roomLightListPos}</pos>
                <size>${roomLightListSize}</size>
            </image>
            <text name="releaseYear">
                <pos>0.94 0.2925</pos>
                <origin>1 0.5</origin>
                <size>0.53 0.3</size>
                <fontSize>0.23</fontSize>
