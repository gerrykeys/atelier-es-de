                <size>0.47 0.296</size>
                <fontSize>${gameTitleSize}</fontSize>
            </text>
            <image name="captionRule">
                <pos>0.4705 0.442</pos>
                <origin>0 0.5</origin>
                <size>0.024 0.0016</size>
            </image>
            <text name="genre">
                <pos>0.505 0.442</pos>
