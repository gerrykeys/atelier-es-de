                <origin>0 0.5</origin>
                <size>0.34 0.04</size>
            </gamelistinfo>
            <text name="labelPlayCount, playCount, labelPlayTime, playTime">
                <visible>false</visible>
            </text>
            <image name="statsRule">
                <visible>false</visible>
            </image>
        </view>
    </variant>

    <!-- Index: the title on one line beside the first row of the list (see the variables
         above), the genre and then the tags over the whole column, the media card
         (0.269) with released, players, last played and the badges beside it in a
         column of 0.18, the stars on a line of their own beneath the first row of badges
         at the right margin, the developer on a line of its own under the card and the
         description, four lines at the medium size and three at the large ones. Only a
         game with eight badges or more would reach the stars with its second row -->
    <variant name="index, indexStill, indexCompact, indexCompactStill, indexNames, indexStillNames, indexCompactNames, indexCompactStillNames, indexList, indexStillList, indexCompactList, indexCompactStillList">
        <view name="gamelist">
            <!-- Taller than the line at every size, see ar-16-9.xml -->
            <text name="gameTitle">
                <pos>${indexTitlePos}</pos>
                <origin>0 0.5</origin>
                <size>0.47 0.12</size>
                <fontSize>${gameTitleSizeNarrow}</fontSize>
            </text>
            <image name="captionRule">
                <pos>0.4705 0.27</pos>
                <origin>0 0.5</origin>
                <size>0.024 0.0016</size>
            </image>
            <text name="genre">
                <pos>0.505 0.27</pos>
                <origin>0 0.5</origin>
                <size>0.435 0.04</size>
            </text>
            <text name="fileTags">
                <pos>0.505 0.307</pos>
                <origin>0 0.5</origin>
                <size>0.435 0.04</size>
            </text>

            <!-- The media card starts at 0.47 0.34 and is 0.26875 x 0.266667: 4:3 within 1%,
                 and an even number of whole pixels at 640x480, 960x720, 1280x960, 1600x1200
                 and 1920x1440, where ES-DE then rounds the card, the stills and the videos
                 of any size to the same pixels (elsewhere, as at 1024x768, a few can still
                 land 1 px off). The card is placed as the media are, see ar-16-9.xml -->
            <image name="mediaAmbient">
                <pos>0.604375 0.473333</pos>
                <origin>0.5 0.5</origin>
                <size>0.3568 0.384</size>
            </image>
            <image name="mediaMatte">
                <pos>0.604375 0.473333</pos>
                <origin>0.5 0.5</origin>
                <size>0.26875 0.266667</size>
                <cornerRadius>0.006</cornerRadius>
            </image>
            <image name="mediaPlaceholder">
                <pos>0.604375 0.473333</pos>
                <origin>0.5 0.5</origin>
                <maxSize>0.1344 0.1067</maxSize>
            </image>

            <text name="labelReleased">
                <pos>0.76 0.35</pos>
                <origin>0 0.5</origin>
                <size>0.18 0.03</size>
            </text>
            <datetime name="releaseDate">
                <pos>0.76 0.383</pos>
                <origin>0 0.5</origin>
                <size>0.18 0.04</size>
            </datetime>
            <text name="labelPlayers">
                <pos>0.76 0.427</pos>
                <origin>0 0.5</origin>
                <size>0.18 0.03</size>
            </text>
            <text name="players">
                <pos>0.76 0.46</pos>
                <origin>0 0.5</origin>
                <size>0.18 0.04</size>
            </text>
            <text name="labelLastPlayed">
                <pos>0.76 0.504</pos>
                <origin>0 0.5</origin>
                <size>0.18 0.03</size>
            </text>
            <datetime name="lastPlayed">
                <pos>0.76 0.537</pos>
                <origin>0 0.5</origin>
                <size>0.18 0.04</size>
            </datetime>
            <badges name="badges">
                <pos>0.76 0.555</pos>
                <origin>0 0</origin>
                <size>0.18 0.068</size>
                <lines>2</lines>
                <itemsPerLine>5</itemsPerLine>
                <itemMargin>0.008 -1</itemMargin>
            </badges>
            <rating name="rating">
                <pos>0.94 0.606</pos>
                <origin>1 0.5</origin>
                <size>0 0.021</size>
            </rating>
            <text name="labelPublisher">
                <visible>false</visible>
            </text>
            <text name="publisher">
                <visible>false</visible>
            </text>

            <text name="labelDeveloper">
                <pos>0.47 0.65</pos>
                <origin>0 0.5</origin>
                <size>0.25 0.03</size>
            </text>
            <text name="developer">
                <pos>0.47 0.683</pos>
                <origin>0 0.5</origin>
                <size>0.47 0.04</size>
            </text>
            <!-- Achievement progress, at the right end of the developer label line -->
            <image name="raProgress">
                <pos>0.94 0.65</pos>
                <origin>1 0.5</origin>
                <maxSize>0.2 0.022</maxSize>
            </image>

            <text name="description">
                <pos>0.47 0.717</pos>
                <origin>0 0</origin>
                <size>0.47 0.168</size>
            </text>
        </view>
    </variant>

    <variant name="index, indexCompact, indexNames, indexCompactNames, indexList, indexCompactList">
        <view name="gamelist">
            <image name="videoStill">
                <pos>0.604375 0.473333</pos>
                <cropSize>0.26875 0.266667</cropSize>
                <cornerRadius>0.006</cornerRadius>
            </image>
            <video name="gameVideo">
                <pos>0.604375 0.473333</pos>
                <cropSize>0.26875 0.266667</cropSize>
                <videoCornerRadius>0.006</videoCornerRadius>
                <imageCornerRadius>0.006</imageCornerRadius>
            </video>
        </view>
    </variant>

    <variant name="indexStill, indexCompactStill, indexStillNames, indexCompactStillNames, indexStillList, indexCompactStillList">
        <view name="gamelist">
            <image name="gameImage">
                <pos>0.604375 0.473333</pos>
                <cropSize>0.26875 0.266667</cropSize>
                <cornerRadius>0.006</cornerRadius>
            </image>
        </view>
    </variant>

    <!-- Compact Index: the Index without the large title, which the list already shows.
         The caption lines up with the first row of the list, everything beneath it moves
         up by 0.075 and the description gets the room, five and a half lines instead of
         nearly four. Only the positions change -->
    <variant name="indexCompact, indexCompactStill, indexCompactNames, indexCompactStillNames, indexCompactList, indexCompactStillList">
        <view name="gamelist">
            <text name="gameTitle">
