<!--
    Layout for 4:3 displays (for example 1024x768, 1600x1200).

    Grid: outer margin 0.06, header at 0.085, content from 0.175 to 0.885, footer at 0.935.
    The system view stacks the drawing above the text, the index keeps a compact
    facts column and leaves out the play statistics.
    Grid variant: covers 0.06-0.4, then title, description and the media card
    (0.51-0.78) with the facts beside it in the 0.46-0.94 column.

    These screens are mostly small handhelds, read with the larger font sizes, so the
    boxes are measured for x-large and every language of languages.xml: the genre
    and the tags have the whole column, the stars a line of their own beneath the
    badges at the right margin, the developer a line of its own or two lines, the
    facts column fits the longest label and relative date, and titles are set in a
    slightly smaller size (gameTitleSizeNarrow), on three lines in the Grid and on
    one line in the Index. What is still too long scrolls, see gamelist-details.xml
    and gamelist-index.xml.
-->

<theme>
    <!-- The clock ends the header line, with Wi-Fi and then the battery to its left, one
         entry spacing (0.008) apart. Wi-Fi is placed by the widest time, 00:00, which is
         3.37 em of the status size; other times leave a little more room.
         The Index title starts its capitals where the first row of the list does, as in
         16:9 (see ar-16-9.xml), in the narrow title size -->
    <variables>
        <wifiPos>0.871 0.085</wifiPos>
        <statusPos>0.845 0.085</statusPos>
        <indexTitlePos>0.47 0.2042</indexTitlePos>
    </variables>
    <fontSize name="small">
        <variables>
            <wifiPos>0.879 0.085</wifiPos>
            <statusPos>0.855 0.085</statusPos>
            <indexTitlePos>0.47 0.2013</indexTitlePos>
        </variables>
    </fontSize>
    <fontSize name="large">
        <variables>
            <wifiPos>0.861 0.085</wifiPos>
            <statusPos>0.832 0.085</statusPos>
            <indexTitlePos>0.47 0.2078</indexTitlePos>
        </variables>
    </fontSize>
    <fontSize name="x-large">
        <variables>
            <wifiPos>0.849 0.085</wifiPos>
            <statusPos>0.816 0.085</statusPos>
            <indexTitlePos>0.47 0.2082</indexTitlePos>
        </variables>
    </fontSize>

    <variant name="all">
        <view name="system, gamelist">
            <!-- Larger prompts would run off the screen, see helpSizeNarrow in theme.xml -->
            <helpsystem name="help">
                <pos>0.06 0.935</pos>
                <fontSize>${helpSizeNarrow}</fontSize>
            </helpsystem>
            <systemstatus name="systemStatus">
                <pos>${statusPos}</pos>
            </systemstatus>
            <systemstatus name="systemStatusWifi">
                <pos>${wifiPos}</pos>
            </systemstatus>
            <clock name="clock">
                <pos>0.94 0.085</pos>
            </clock>
        </view>

        <!-- Custom collection header, see collections.xml -->
        <view name="gamelist">
            <text name="collectionTitle">
                <pos>0.147 0.085</pos>
                <origin>0 0.5</origin>
                <size>0.6 0.06</size>
            </text>
            <text name="collectionPlatform">
                <pos>0.147 0.128</pos>
                <origin>0 0.5</origin>
                <size>0.6 0.03</size>
            </text>
            <text name="collectionName">
                <pos>0.94 0.86</pos>
                <origin>1 1</origin>
                <size>0.7 0.4</size>
                <fontSize>0.115</fontSize>
            </text>
        </view>
    </variant>

    <!-- The system carousel, see layout/system-carousel.xml. A long name takes two lines,
         which grow upwards from 0.655, so the drawing ends above 0.46: the item is low
         enough for tall drawings (handhelds, the folder of systems without one) to stay
         clear, while the wide controllers are held by their width and keep their size -->
    <variant name="index, indexStill, indexCompact, indexCompactStill, typographic, gallery, grid, indexNames, indexStillNames, indexCompactNames, indexCompactStillNames, typographicNames, galleryNames, gridNames">
        <view name="system">
            <carousel name="systemCarousel">
                <itemSize>0.26 0.19</itemSize>
                <itemScale>1.6</itemScale>
                <maxItemCount>3.2</maxItemCount>
                <selectedItemMargins>0.05 0.05</selectedItemMargins>
                <verticalOffset>-0.19</verticalOffset>
            </carousel>
            <image name="roomLight">
                <pos>0.5 0.31</pos>
                <size>0.95 0.85</size>
            </image>
            <text name="systemTitle, autoCollectionTitle, customCollectionTitle">
                <pos>0.5 0.655</pos>
                <origin>0.5 1</origin>
                <size>0.9 0.2</size>
                <fontSize>${sysTitleSizeNarrow}</fontSize>
            </text>
            <text name="caption">
                <pos>0.5 0.695</pos>
                <origin>0.5 0.5</origin>
                <size>0.9 0.04</size>
            </text>
            <text name="description">
                <pos>0.5 0.732</pos>
                <origin>0.5 0</origin>
                <size>0.84 0.095</size>
            </text>
            <text name="gameCount">
                <pos>0.5 0.86</pos>
                <origin>0.5 0.5</origin>
                <size>0.6 0.04</size>
            </text>
        </view>
    </variant>

    <!-- The Names variants, see layout/system-names.xml. The carousel items gain the strips
         above and below the drawing; the veil covers the name of the selected system,
         from just beneath the tallest drawing, and stops short of its neighbors -->
    <variant name="indexNames, indexStillNames, indexCompactNames, indexCompactStillNames, typographicNames, galleryNames, gridNames">
        <view name="system">
            <carousel name="systemCarousel">
                <itemSize>0.26 0.4025</itemSize>
                <verticalOffset>-0.2</verticalOffset>
            </carousel>
            <image name="selectedNameVeil">
                <pos>0.5 0.5585</pos>
                <size>0.44 0.133</size>
            </image>
        </view>
    </variant>

    <!-- The List variants, see layout/system-list.xml: the list of systems where the
         Index has its list of games, the selected system described in the 0.47-0.94
         column as in 16:9, with a smaller drawing and year, and the name in the size of
         the game titles here, on up to two lines -->
    <variant name="indexList, indexStillList, indexCompactList, indexCompactStillList, typographicList, galleryList, gridList">
        <view name="system">
            <textlist name="systemList">
                <pos>0.06 0.175</pos>
                <origin>0 0</origin>
                <size>0.36 0.65</size>
                <horizontalMargin>0.014</horizontalMargin>
                <selectorWidth>0.0016</selectorWidth>
                <selectorHeight>${selectorH}</selectorHeight>
                <selectorVerticalOffset>${selectorY}</selectorVerticalOffset>
            </textlist>
            <!-- The fade ends 0.001 past the text edge (0.406): ES-DE rounds the list's clip
                 in three steps, which can put its edge up to 1.4 px further right -->
            <image name="listFade">
                <pos>0.407 0.175</pos>
                <origin>1 0</origin>
                <size>0.045 0.65</size>
            </image>
            <image name="systemArt">
                <pos>0.47 0.38</pos>
                <origin>0 1</origin>
                <maxSize>0.42 0.205</maxSize>
            </image>
            <!-- Centered on the drawing, set for each system by systems/eyebrow -->
            <image name="roomLight">
                <pos>${roomLightListPos}</pos>
                <size>${roomLightListSize}</size>
            </image>
            <text name="releaseYear">
                <pos>0.94 0.2775</pos>
                <origin>1 0.5</origin>
                <size>0.47 0.25</size>
                <fontSize>0.18</fontSize>
            </text>
            <text name="systemTitle, autoCollectionTitle, customCollectionTitle">
                <pos>0.47 0.51</pos>
                <origin>0 1</origin>
                <size>0.47 0.125</size>
                <fontSize>${gameTitleSizeNarrow}</fontSize>
            </text>
            <image name="captionRule">
                <pos>0.4705 0.545</pos>
                <origin>0 0.5</origin>
                <size>0.024 0.0016</size>
            </image>
            <text name="caption">
                <pos>0.505 0.545</pos>
                <origin>0 0.5</origin>
                <size>0.435 0.04</size>
            </text>
            <text name="description">
                <pos>0.47 0.58</pos>
                <origin>0 0</origin>
                <size>0.47 0.245</size>
            </text>
            <text name="gameCount">
                <pos>0.47 0.865</pos>
                <origin>0 0.5</origin>
                <size>0.47 0.04</size>
            </text>
        </view>
    </variant>

    <variant name="index, indexStill, indexCompact, indexCompactStill, typographic, indexNames, indexStillNames, indexCompactNames, indexCompactStillNames, typographicNames, indexList, indexStillList, indexCompactList, indexCompactStillList, typographicList">
        <view name="gamelist">
            <text name="header">
                <pos>0.147 0.085</pos>
                <origin>0 0.5</origin>
                <size>0.58 0.04</size>
            </text>
            <image name="headerArt">
                <pos>0.136 0.085</pos>
                <origin>1 0.5</origin>
                <maxSize>0.0756 0.04</maxSize>
            </image>
            <textlist name="gamelistTextlist">
                <pos>0.06 0.175</pos>
                <origin>0 0</origin>
                <size>0.36 0.65</size>
                <horizontalMargin>0.014</horizontalMargin>
                <selectorWidth>0.0016</selectorWidth>
                <selectorHeight>${selectorH}</selectorHeight>
                <selectorVerticalOffset>${selectorY}</selectorVerticalOffset>
            </textlist>
            <!-- 0.001 past the text edge, as in the system view -->
            <image name="listFade">
                <pos>0.407 0.175</pos>
                <origin>1 0</origin>
                <size>0.045 0.65</size>
            </image>
