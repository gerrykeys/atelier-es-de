<!--
    Atelier for ES-DE (atelier-es-de)
    License: MIT (theme configuration and original artwork), see LICENSE and CREDITS.md

    Parsing order matters here: the metadata files must be included before the
    eyebrow files, which compose their caption from the (possibly localized) metadata
    variables at definition time.
-->

<theme>
    <include>./layout/defaults.xml</include>
    <include>./systems/metadata/_default.xml</include>
    <include>./systems/metadata/${system.theme}.xml</include>
    <!-- The room light of the List variants on the fallback drawing, for the systems
         that have no drawing of their own, see tools/build-eyebrows.js -->
    <include>./systems/eyebrow/_default.xml</include>
    <include>./systems/eyebrow/${system.theme}.xml</include>
    <include>./layout/colors.xml</include>
    <include>./layout/languages.xml</include>
    <!-- Whether the achievement progress images are shown, see achievements/scripts/windows/progress.ps1 -->
    <include>./achievements/progress.xml</include>

    <!-- Paths are relative to the layout files, which is where every element is defined -->
    <variables>
        <fontDisplay>./../core/fonts/GoogleSansFlex-DisplayLight.ttf</fontDisplay>
        <fontDisplayRegular>./../core/fonts/GoogleSansFlex-DisplayRegular.ttf</fontDisplayRegular>
        <fontText>./../core/fonts/GoogleSansFlex-Regular.ttf</fontText>
        <fontCaps>./../core/fonts/AtelierCaps-Medium.ttf</fontCaps>
        <fontCapsLight>./../core/fonts/AtelierCaps-Regular.ttf</fontCapsLight>
        <!-- Shows only the bracketed parts of a file name, as tags: see tools/build-tag-font.js -->
        <fontTags>./../core/fonts/AtelierTags.otf</fontTags>
        <!-- Titles on Grid and Gallery tiles; the Collections system uses the light display face, larger -->
        <tileFont>${fontDisplayRegular}</tileFont>

        <pixel>./../core/images/pixel.png</pixel>
        <artPath>./../systems/controllers/${system.theme}.svg</artPath>
        <artFallback>./../systems/controllers/custom-collections.svg</artFallback>
        <!-- The system carousel's drawing: systems that share theirs with others get a
             copy naming the model, set by systems/eyebrow (see tools/build-model-tags.js) -->
        <systemArt>${artPath}</systemArt>
        <!-- The Names variants: the drawings with the name of the system, the translated
             collections set their own in systems/eyebrow (see tools/build-named-art.js) -->
        <namedArt>./../systems/controllers-named/${system.theme}.svg</namedArt>
        <namedArtFallback>./../systems/controllers-named/_fallback.svg</namedArtFallback>
        <!-- Swapped by systems/eyebrow/custom-collections.xml, see layout/collections.xml -->
        <regularHeaderVisible>true</regularHeaderVisible>
        <collectionHeaderVisible>false</collectionHeaderVisible>
        <!-- Off for RetroAchievements and Catalogue, whose only entry opens the app -->
        <gameCountVisible>true</gameCountVisible>
        <!-- Off in the Collections system, where the list of collections would play a random game -->
        <videoAudio>true</videoAudio>
    </variables>

    <!-- Font sizes are em heights relative to the screen height. The narrow help size is
         the one of 4:3 screens, whose footer has no room for larger prompts, and the
         narrow game title lets a long title take three lines in their narrower column
         without being cut off. The status
         size is the clock and the height of the system status icons, a little larger than
         the small capitals so that they read at a glance -->
    <fontSize name="medium">
        <variables>
            <capsSize>0.019</capsSize>
            <statusSize>0.024</statusSize>
            <helpSize>0.026</helpSize>
            <helpSizeNarrow>0.026</helpSizeNarrow>
            <sysTitleSize>0.085</sysTitleSize>
            <sysTitleSizeNarrow>0.075</sysTitleSizeNarrow>
            <sysDescSize>0.025</sysDescSize>
            <listSize>0.027</listSize>
            <listSpacing>1.9</listSpacing>
            <selectorH>0.0176</selectorH>
            <selectorY>0.0115</selectorY>
            <gameTitleSize>0.058</gameTitleSize>
            <gameTitleSizeNarrow>0.05</gameTitleSizeNarrow>
            <typoTitleSize>0.085</typoTitleSize>
            <labelSize>0.0158</labelSize>
            <tagSize>0.0158</tagSize>
            <valueSize>0.0245</valueSize>
            <descSize>0.024</descSize>
            <galleryTitleSize>0.058</galleryTitleSize>
            <coverTextSize>0.028</coverTextSize>
            <gridTextSize>0.016</gridTextSize>
            <collectionGridTextSize>0.03</collectionGridTextSize>
            <collectionTitleSize>0.034</collectionTitleSize>
        </variables>
    </fontSize>
    <fontSize name="large">
        <variables>
            <capsSize>0.022</capsSize>
            <statusSize>0.028</statusSize>
            <helpSize>0.03</helpSize>
            <helpSizeNarrow>0.03</helpSizeNarrow>
            <sysTitleSize>0.097</sysTitleSize>
            <sysTitleSizeNarrow>0.086</sysTitleSizeNarrow>
            <sysDescSize>0.029</sysDescSize>
            <listSize>0.032</listSize>
            <listSpacing>1.75</listSpacing>
            <selectorH>0.0208</selectorH>
            <selectorY>0.0136</selectorY>
            <gameTitleSize>0.066</gameTitleSize>
            <gameTitleSizeNarrow>0.054</gameTitleSizeNarrow>
            <typoTitleSize>0.097</typoTitleSize>
            <labelSize>0.018</labelSize>
            <tagSize>0.018</tagSize>
            <valueSize>0.028</valueSize>
            <descSize>0.028</descSize>
            <galleryTitleSize>0.066</galleryTitleSize>
            <coverTextSize>0.032</coverTextSize>
            <gridTextSize>0.019</gridTextSize>
            <collectionGridTextSize>0.034</collectionGridTextSize>
            <collectionTitleSize>0.04</collectionTitleSize>
        </variables>
    </fontSize>
    <fontSize name="small">
        <variables>
            <capsSize>0.0165</capsSize>
            <statusSize>0.021</statusSize>
            <helpSize>0.023</helpSize>
            <helpSizeNarrow>0.023</helpSizeNarrow>
            <sysTitleSize>0.075</sysTitleSize>
            <sysTitleSizeNarrow>0.066</sysTitleSizeNarrow>
            <sysDescSize>0.0225</sysDescSize>
            <listSize>0.0235</listSize>
            <listSpacing>2</listSpacing>
            <selectorH>0.0153</selectorH>
            <selectorY>0.01</selectorY>
            <gameTitleSize>0.052</gameTitleSize>
            <gameTitleSizeNarrow>0.046</gameTitleSizeNarrow>
            <typoTitleSize>0.075</typoTitleSize>
            <labelSize>0.0145</labelSize>
            <tagSize>0.0145</tagSize>
            <valueSize>0.022</valueSize>
            <descSize>0.0215</descSize>
            <galleryTitleSize>0.052</galleryTitleSize>
            <coverTextSize>0.025</coverTextSize>
            <gridTextSize>0.014</gridTextSize>
            <collectionGridTextSize>0.027</collectionGridTextSize>
            <collectionTitleSize>0.03</collectionTitleSize>
        </variables>
    </fontSize>
    <!-- For small screens held in the hand, such as a 4" handheld: the small capitals
         (header, genre, game count), the clock and system status, the file tags, the
         help prompts and the list grow, everything else stays as in large. The fact
         labels and values sit in narrow columns where larger text would be cut off -->
    <fontSize name="x-large">
        <variables>
            <capsSize>0.027</capsSize>
            <statusSize>0.033</statusSize>
            <helpSize>0.034</helpSize>
            <helpSizeNarrow>0.03</helpSizeNarrow>
            <sysTitleSize>0.097</sysTitleSize>
            <sysTitleSizeNarrow>0.086</sysTitleSizeNarrow>
            <sysDescSize>0.029</sysDescSize>
            <listSize>0.035</listSize>
            <listSpacing>1.7</listSpacing>
            <selectorH>0.0228</selectorH>
            <selectorY>0.0149</selectorY>
            <gameTitleSize>0.066</gameTitleSize>
            <gameTitleSizeNarrow>0.054</gameTitleSizeNarrow>
            <typoTitleSize>0.097</typoTitleSize>
            <labelSize>0.018</labelSize>
            <tagSize>0.022</tagSize>
            <valueSize>0.028</valueSize>
            <descSize>0.028</descSize>
            <galleryTitleSize>0.066</galleryTitleSize>
            <coverTextSize>0.032</coverTextSize>
            <gridTextSize>0.022</gridTextSize>
            <collectionGridTextSize>0.036</collectionGridTextSize>
            <collectionTitleSize>0.04</collectionTitleSize>
        </variables>
    </fontSize>

    <variant name="all">
        <include>./layout/common.xml</include>
        <include>./layout/system.xml</include>
        <include>./layout/sounds.xml</include>
        <include>./layout/collections.xml</include>
    </variant>
    <!-- Every variant has two twins, with the same game lists: a theme has no other option
         ES-DE would show in its menu. The Names twins have the names of the neighboring
         systems in the carousel, the List twins replace the carousel with a list of the
         systems. ES-DE takes a single carousel or list in the system view, so the carousel
         is only defined for the variants that show it -->
    <variant name="index, indexStill, indexCompact, indexCompactStill, typographic, gallery, grid, indexNames, indexStillNames, indexCompactNames, indexCompactStillNames, typographicNames, galleryNames, gridNames">
        <include>./layout/system-carousel.xml</include>
    </variant>
    <variant name="indexNames, indexStillNames, indexCompactNames, indexCompactStillNames, typographicNames, galleryNames, gridNames">
        <include>./layout/system-names.xml</include>
    </variant>
    <!-- On "automatic" transitions the List twins change the page at once between systems,
         see tools/build-capabilities.js -->
    <variant name="indexList, indexStillList, indexCompactList, indexCompactStillList, typographicList, galleryList, gridList">
        <transitions>softList</transitions>
        <include>./layout/system-list.xml</include>
    </variant>
    <!-- The compact Index variants are the Index without the large title, see the
         aspect ratio files -->
    <variant name="index, indexStill, indexCompact, indexCompactStill, typographic, indexNames, indexStillNames, indexCompactNames, indexCompactStillNames, typographicNames, indexList, indexStillList, indexCompactList, indexCompactStillList, typographicList">
        <include>./layout/gamelist-list.xml</include>
        <include>./layout/gamelist-details.xml</include>
    </variant>
    <variant name="index, indexStill, indexCompact, indexCompactStill, indexNames, indexStillNames, indexCompactNames, indexCompactStillNames, indexList, indexStillList, indexCompactList, indexCompactStillList">
        <include>./layout/gamelist-index.xml</include>
    </variant>
    <variant name="index, indexCompact, indexNames, indexCompactNames, indexList, indexCompactList">
        <include>./layout/gamelist-media-video.xml</include>
    </variant>
    <variant name="indexStill, indexCompactStill, indexStillNames, indexCompactStillNames, indexStillList, indexCompactStillList">
        <include>./layout/gamelist-media-still.xml</include>
    </variant>
    <variant name="typographic, typographicNames, typographicList">
        <include>./layout/gamelist-typographic.xml</include>
    </variant>
    <variant name="gallery, galleryNames, galleryList">
        <include>./layout/gamelist-gallery.xml</include>
    </variant>
    <variant name="grid, gridNames, gridList">
        <include>./layout/gamelist-details.xml</include>
        <include>./layout/gamelist-media-video.xml</include>
        <include>./layout/gamelist-grid.xml</include>
    </variant>

    <!-- All positions and sizes live in the aspect ratio files -->
    <aspectRatio name="21:9">
        <include>./layout/ar-21-9.xml</include>
    </aspectRatio>
    <aspectRatio name="16:9, 16:10">
        <include>./layout/ar-16-9.xml</include>
    </aspectRatio>
    <aspectRatio name="4:3">
        <include>./layout/ar-4-3.xml</include>
    </aspectRatio>
</theme>
